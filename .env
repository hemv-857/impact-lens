DATABASE_URL=file:../db/custom.db

# AI provider preset — fills base URL + model IDs. Default is gemini; key goes in .env.local.
AI_PROVIDER=gemini
# key: GEMINI_API_KEY (or AI_API_KEY) in .env.local
# Other presets: AI_PROVIDER=openai | AI_PROVIDER=groq
# Image generation uses Gemini's native endpoint (needs a billing-enabled key; free tier 429s).
# Note: Gemini rejects video_url parts — video analysis needs a video-capable AI_BASE_URL.

# Or skip presets and point at any OpenAI-compatible endpoint manually:
# AI_BASE_URL=https://api.openai.com/v1
# AI_TEXT_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini
# AI_IMAGE_MODEL=gpt-image-1
# Put your secret in .env.local (gitignored): AI_API_KEY=sk-...

# NEXTAUTH_SECRET (signing key for sessions) lives in .env.local — never commit it.

# Scheduled reports + email delivery (optional).
# CRON_SECRET guards POST /api/cron/reports — set it, then point a scheduler at that endpoint.
# CRON_SECRET=change-me
# EMAIL_API_BASE_URL=https://api.provider.test   # expects POST /emails {from,to,subject,text,html}
# EMAIL_API_KEY=...
# EMAIL_FROM=ImpactLens <reports@your.org>

# Slack cron notifications (optional) — cron posts a one-line run summary here.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# Cloudinary storage (F2) — real URL lives in .env.local, never here.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
