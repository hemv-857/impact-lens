DATABASE_URL=file:../db/custom.db

# OpenAI-compatible AI provider — any endpoint works (OpenAI, OpenRouter, Groq,
# DeepSeek, Gemini compat, Ollama, Z.ai GLM proxy, ...).
AI_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini
AI_IMAGE_MODEL=gpt-image-1
# Put your secret in .env.local (gitignored): AI_API_KEY=sk-...
