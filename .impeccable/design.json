  "components": [
    {
      "name": "Commit Button",
      "kind": "button",
      "refersTo": "button-commit",
      "description": "The one ember action per view: Add media, Verify, Generate.",
      "html": "<button class=\"ds-btn-commit\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg>Add media</button>",
      "css": ".ds-btn-commit{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 16px;border:0;border-radius:8px;background:#ef8a4a;color:#1c0f06;font:600 14px/1 'Public Sans',system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-commit:hover{background:#f79b5f}.ds-btn-commit:focus-visible{outline:2px solid #ef8a4a;outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Row-level Verify and Analyze actions.",
      "html": "<button class=\"ds-btn-outline\">Verify</button>",
      "css": ".ds-btn-outline{height:28px;padding:0 10px;border:1px solid #3a322b;border-radius:8px;background:rgba(58,50,43,.3);color:#f5eee6;font:500 14px/1 'Public Sans',system-ui,sans-serif;cursor:pointer;transition:background-color .15s}.ds-btn-outline:hover{background:rgba(58,50,43,.5)}.ds-btn-outline:focus-visible{outline:2px solid #ef8a4a;outline-offset:2px}"
    },
    {
      "name": "Ghost Accent Button",
      "kind": "button",
      "refersTo": "button-ghost-accent",
      "description": "Secondary bulk action in ember text.",
      "html": "<button class=\"ds-btn-ghost\">Verify all 3 analyzed</button>",
      "css": ".ds-btn-ghost{height:32px;padding:0 12px;border:0;border-radius:8px;background:transparent;color:#f5a771;font:500 14px/1 'Public Sans',system-ui,sans-serif;cursor:pointer}.ds-btn-ghost:hover{background:#2a1a10}.ds-btn-ghost:focus-visible{outline:2px solid #ef8a4a;outline-offset:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Top-bar command palette trigger with a mono key hint.",
      "html": "<button class=\"ds-search\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.5-3.5\"/></svg><span>Search assets, projects, reports…</span><kbd>⌘K</kbd></button>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;width:360px;height:40px;padding:0 12px;border:1px solid #2a241f;border-radius:8px;background:#1b1714;color:#8a7e70;font:400 14px 'Public Sans',system-ui,sans-serif;cursor:pointer;transition:border-color .15s}.ds-search:hover{border-color:#4a4038}.ds-search:focus-visible{outline:2px solid #ef8a4a;outline-offset:2px}.ds-search kbd{margin-left:auto;padding:0 6px;border:1px solid #2a241f;border-radius:4px;font:11px 'Geist Mono',ui-monospace,monospace}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Left rail sections; active item raised with an ember icon, Home carries the review count.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-nav on\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z\"/></svg>Home<span class=\"ds-count\">1</span></a><a class=\"ds-nav\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><circle cx=\"9\" cy=\"9\" r=\"2\"/><path d=\"m21 15-5-5L5 21\"/></svg>Library</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;width:216px;padding:12px;background:#110e0c}.ds-nav{display:flex;align-items:center;gap:12px;height:40px;padding:0 12px;border-radius:8px;color:#9c8f80;font:500 14px 'Public Sans',system-ui,sans-serif;text-decoration:none;transition:background-color .15s,color .15s}.ds-nav svg{color:#6b6055}.ds-nav:hover{background:#1b1714;color:#f5eee6}.ds-nav.on{background:#231e1a;color:#f5eee6}.ds-nav.on svg{color:#ef8a4a}.ds-nav:focus-visible{outline:2px solid #ef8a4a;outline-offset:2px}.ds-count{margin-left:auto;padding:0 6px;border-radius:6px;background:#2a1a10;color:#f5a771;font-size:12px;font-weight:600;line-height:20px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "View Tabs",
      "kind": "nav",
      "refersTo": "nav-item-active",
      "description": "Section h1 and underline tabs on one hairline; ember underline marks the active view.",
      "html": "<div class=\"ds-tabs\"><h1>Library</h1><button class=\"on\">Media</button><button>Search</button><button>Timeline</button></div>",
      "css": ".ds-tabs{display:flex;align-items:flex-end;gap:4px;border-bottom:1px solid #2a241f;font-family:'Public Sans',system-ui,sans-serif}.ds-tabs h1{margin:0 28px 0 0;padding-bottom:12px;font-size:24px;font-weight:600;letter-spacing:-.025em;color:#f5eee6}.ds-tabs button{margin-bottom:-1px;padding:4px 12px 12px;border:0;border-bottom:2px solid transparent;background:none;color:#9c8f80;font-size:14px;cursor:pointer}.ds-tabs button:hover{color:#f5eee6}.ds-tabs button.on{border-color:#ef8a4a;color:#f5eee6;font-weight:500}.ds-tabs button:focus-visible{outline:2px solid #ef8a4a;outline-offset:2px}"
    },
    {
      "name": "Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "AI tags on assets; SDG tags use the slate variant.",
      "html": "<span class=\"ds-tag\">reforestation</span> <span class=\"ds-tag ds-sdg\">SDG 13</span>",
      "css": ".ds-tag{display:inline-block;padding:2px 8px;border-radius:6px;background:#231e1a;color:#b3a697;font:400 12px/1.33 'Public Sans',system-ui,sans-serif}.ds-sdg{background:#22252a;border:1px solid #363b40;color:#c6cbd0}"
    },
    {
      "name": "Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Tonal panel with a hairline edge and a title row.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-h\"><h2>Active projects</h2><a href=\"#\">All →</a></div><p>Mangrove Restoration<br><small>Sundarbans, Bangladesh</small></p></section>",
      "css": ".ds-panel{width:320px;padding:24px;border:1px solid #2a241f;border-radius:16px;background:#1b1714;color:#f5eee6;font-family:'Public Sans',system-ui,sans-serif;transition:border-color .15s}.ds-panel:hover{border-color:#3a322b}.ds-panel-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.ds-panel h2{margin:0;font-size:18px;font-weight:600}.ds-panel-h a{color:#9c8f80;font-size:14px;text-decoration:none}.ds-panel-h a:hover{color:#f5eee6}.ds-panel p{margin:0;font-size:14px;font-weight:500}.ds-panel small{color:#9c8f80;font-size:12px;font-weight:400}"
    },
    {
      "name": "Review Row",
      "kind": "custom",
      "refersTo": "media-card",
      "description": "Accession number in mono, tabular confidence, evidence mark, outline Verify.",
      "html": "<div class=\"ds-row\"><span class=\"ds-thumb\"></span><span class=\"ds-meta\"><b>Mangrove Restoration Planting</b><small><code>A·ORNI9S</code> Wetland Restoration · 7d ago</small></span><span class=\"ds-conf\">88%</span><svg viewBox=\"0 0 16 16\" width=\"20\" height=\"20\" role=\"img\" aria-label=\"Analyzed, not verified\"><circle cx=\"8\" cy=\"8\" r=\"6.2\" fill=\"none\" stroke=\"#85796c\" stroke-width=\"1.6\"/></svg><button class=\"ds-btn-outline\">Verify</button></div>",
      "css": ".ds-row{display:flex;align-items:center;gap:16px;width:560px;padding:12px 0;border-bottom:1px solid #2a241f;color:#f5eee6;font-family:'Public Sans',system-ui,sans-serif}.ds-thumb{width:112px;height:64px;border-radius:8px;background:#231e1a;flex-shrink:0}.ds-meta{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}.ds-meta b{font-size:16px;font-weight:500}.ds-meta small{color:#9c8f80;font-size:12px}.ds-meta code{font:11px 'Geist Mono',ui-monospace,monospace;color:#b3a697;margin-right:8px}.ds-conf{font-size:16px;font-weight:500;font-variant-numeric:tabular-nums;color:#cfc3b4}.ds-btn-outline{height:28px;padding:0 10px;border:1px solid #3a322b;border-radius:8px;background:rgba(58,50,43,.3);color:#f5eee6;font:500 14px 'Public Sans',sans-serif;cursor:pointer}.ds-btn-outline:hover{background:rgba(58,50,43,.5)}"
