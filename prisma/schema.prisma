// ImpactLens — AI-Powered Impact & Sustainability Media Platform
// Prisma schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  location    String?
  region      String?
  category    String? // reforestation, solar, water, education, cleanup, agriculture, infrastructure
  status      String   @default("active") // active, completed, planning
  startDate   DateTime?
  endDate     DateTime?
  sdgGoals    String?  // comma-separated UN SDG numbers
  coverUrl    String?
  lat         Float?   // map latitude
  lng         Float?   // map longitude
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      MediaAsset[]
  reports     Report[]
  @@index([orgId])
}

model MediaAsset {
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  publicId      String   @unique // cloudinary-style public id
  title         String
  description   String?
  type          String   @default("image") // image, video
  url           String
  thumbnailUrl  String?
  format        String?  // png, jpg
  width         Int?
  height        Int?
  bytes         Int?

  // AI-extracted intelligence
  aiCaption     String?
  aiSummary     String?
  aiDescription String? // long-form VLM analysis
  projectName   String? // detected project name
  location      String? // detected location
  activity      String? // detected activity
  category      String? // detected category
  signals       String? // JSON array of visual signals
  objects       String? // JSON array of detected objects
  tagsCsv       String? // comma-separated tags
  mood          String? // tone/mood
  confidence    Float?  // 0-1 analysis confidence
  ocrText       String? // extracted text
  qualityScore  Float?

  // Traceability
  source        String?  // upload, generated, web-search
  originalUrl   String?  // original source if transformed
  transformations String? // JSON array of transform steps
  captureDate   DateTime?
  verified      Boolean  @default(false)
  analyzedAt    DateTime?
  favorite      Boolean  @default(false) // user bookmark

  projectId     String?
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Before/after pairing
  pairGroup     String? // shared id links before/after set
  pairRole      String? // "before" | "after"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([category])
  @@index([pairGroup])
  @@index([orgId])
}

model Report {
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id          String   @id @default(cuid())
  title       String
  type        String   @default("impact") // impact, summary, campaign, comparison
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  headline    String?
  summary     String
  narrative   String? // long-form markdown
  metrics     String? // JSON of KPIs
  mediaIds    String? // JSON array of referenced asset ids
  callToAction String?
  tone        String? // professional, emotional, data-driven
  shareToken  String? @unique // public read-only link /share/<token>
  createdAt   DateTime @default(now())
  @@index([orgId])
}

model AiUsageLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  kind       String // chat | vision | image | gemini-native
  model      String?
  provider   String?
  durationMs Int
  ok         Boolean
  status     Int?
  error      String?
  @@index([createdAt])
}

model Comparison {
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  beforeId     String
  afterId      String
  projectId    String?
  narrative    String?
  changes      String? // JSON array of detected changes
  impactScore  Float?
  createdAt    DateTime @default(now())
  @@index([orgId])
}

model SavedSearch {
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id          String   @id @default(cuid())
  query       String
  label       String?  // user-friendly name
  hitCount    Int      @default(0)
  results     String?  // JSON array of {assetId, score, reason}
  createdAt   DateTime @default(now())
  @@index([orgId])
}

model AssetNote {
  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id          String   @id @default(cuid())
  assetId     String
  body        String
  author      String?  // optional author name
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assetId])
  @@index([orgId])
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  inviteCode  String?  @unique // F9: join-by-invite; null until an owner fetches/regenerates it
  createdAt   DateTime @default(now())

  users       Membership[]
  schedules   ReportSchedule[]
  projects    Project[]
  assets      MediaAsset[]
  reports     Report[]
  comparisons Comparison[]
  searches    SavedSearch[]
  notes       AssetNote[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())

  memberships  Membership[]
}

model Membership {
  id     String @id @default(cuid())
  userId String
  orgId  String
  role   String @default("member") // owner | member
  createdAt DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model ReportSchedule {
  id         String    @id @default(cuid())
  orgId      String
  org        Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name       String?
  type       String    @default("impact") // impact | summary | campaign | comparison
  tone       String    @default("professional")
  projectId  String?
  assetIds   String?    // JSON array of asset ids; null = latest org assets
  audience   String?
  everyDays  Int       @default(7)
  emailTo    String?
  active     Boolean   @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([orgId])
}
